{
  "name": "wind-up-rush",
  "version": "0.1.0",
  "private": true,
  "description": "Wind-Up Rush \u2014 wind-up toy racing on Base",
  "workspaces": [
    "frontend",
    "backend",
    "contracts"
  ],
  "scripts": {
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "contracts": "npx hardhat compile --config contracts/hardhat.config.ts",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "qa": "tsx qa-agent.ts",
    "lint:vocab": "bash tools/check-vocabulary.sh"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0"
  }
}
